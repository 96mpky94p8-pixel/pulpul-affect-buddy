# ==========================================
# Core API Credentials (Required)
# ==========================================
DISCORD_TOKEN=your_discord_bot_token_here
GEMINI_API_KEY=your_gemini_api_key_here
PORT=8080

# ==========================================
# Channel Configuration (Optional)
